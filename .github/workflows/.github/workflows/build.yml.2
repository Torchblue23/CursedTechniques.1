name: Build Mod

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v3
    - uses: uses: actions/upload-artifact@v4
      with:
        dotnet-version: '6.0.x'
    - run: dotnet add CursedTechniques.csproj package Pathoschild.Stardew.ModBuildConfig --version 4.1.1
    - run: dotnet build CursedTechniques.csproj --configuration Release
    - uses: actions/upload-artifact@v3
      with:
        name: CursedTechniques
        path: bin/Release/net6.0/CursedTechniques.dll
