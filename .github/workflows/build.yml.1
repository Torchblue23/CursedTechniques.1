name: Build Mod

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v4
    - uses: actions/setup-dotnet@v4
      with:
        dotnet-version: '6.0.x'
    - run: dotnet add CursedTechniques.csproj package Pathoschild.Stardew.ModBuildConfig --version 4.1.1
    - run: dotnet build CursedTechniques.csproj --configuration Release
    - uses: actions/upload-artif
